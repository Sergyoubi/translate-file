generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model TranslationFile {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName          String
  updatedBy         String                   @default("John")
  translations      TranslationContent[] 
}

model TranslationContent {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String
  value          String
  File           TranslationFile?  @relation(fields: [fileId], references: [id])
  fileId         String?           @db.Uuid
}